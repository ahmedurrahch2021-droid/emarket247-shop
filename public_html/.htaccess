Options -MultiViews -Indexes
DirectoryIndex index.html

# ---- Never serve source, data, or configuration material -------------------
# Database dumps, documentation, environment files, logs, and editor/VCS
# leftovers must not be downloadable even if one is uploaded to the server by
# mistake. Deployment material now lives in the repository's /database folder,
# outside this web root; this rule is the safety net.
<FilesMatch "(?:^\.|\.(?:sql|sql\.gz|env|log|ini|bak|old|orig|swp|dist|json5|md|yml|yaml|lock|sh)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# The catalogue JSON the storefront fetches at runtime must stay reachable,
# so .json is deliberately absent from the block list above.

# eMarket247 is a multi-page static site, not a single-page application.
# No catch-all rewrite is used, so an unknown URL returns a genuine HTTP 404
# and is served the branded 404 page below instead of a soft-404 homepage.
ErrorDocument 404 /404.html

# ---- Dynamic Product Detail Pages (database is the single source of truth) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---- Force HTTPS -------------------------------------------------------
  # Must stay ahead of the product rewrite so an insecure request is upgraded
  # before anything else runs. %{HTTPS} alone is unreliable behind a proxy or
  # load balancer, so the forwarded-proto header is checked as well.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ---- Retired development URLs -------------------------------------------
  # /{lang}/studio-pilot/ was an internal prototype used while the product
  # grid was being rebuilt. It shipped with noindex,nofollow, was never in the
  # sitemap, and three of its demo photographs were never uploaded, so it only
  # ever served broken images. The page is gone; a permanent move keeps the few
  # links that once pointed at it useful instead of dropping them on a 404.
  RewriteRule ^(en|bn)/studio-pilot/?$ /$1/shop/ [R=301,L]

  # ---- Retired occasion URLs ---------------------------------------------
  # /occasions/bridal/ was folded into /occasions/wedding/: one occasion, one
  # page. These are permanent moves, so whatever authority and inbound links
  # the retired URLs earned are passed on instead of being lost to a 404.
  # Kept after the HTTPS block so an insecure request is upgraded first and
  # the visitor never sees a second redirect hop.
  RewriteRule ^(en|bn)/occasions/bridal/?$ /$1/occasions/wedding/ [R=301,L]

  # Route EVERY /{lang}/products/{slug}/ to product.php. The live DB row is
  # rendered when it exists; otherwise product.php falls back to any legacy
  # static index.html, then to the branded 404. This is what keeps prices on
  # detail pages in sync with the admin no matter what changed in the DB.
  RewriteRule ^(en|bn)/products/([a-z0-9-]+)/?$ /product.php?lang=$1&slug=$2 [L,QSA]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # The stylesheet and script are requested with a ?v= content hash, so a new
  # release is a new URL. A long cache is therefore safe and cannot serve a
  # stale stylesheet alongside an updated script.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
  # HTML carries the ?v= references, so it must revalidate quickly for a
  # release to reach visitors.
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # HTTP Strict Transport Security. Deliberately set to 180 days rather than a
  # year: it is long enough to protect real visitors and short enough to
  # recover from a certificate problem during launch. Raise to 31536000 and
  # add "preload" only after HTTPS has been stable in production.
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # The storefront loads no third-party JavaScript, so script sources are
  # limited to this origin. 'unsafe-inline' is still required because the
  # pages carry inline event handlers and inline JSON-LD; removing those is
  # tracked as follow-up hardening, after which 'unsafe-inline' should go.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  # The storefront needs no camera, microphone, geolocation, or payment API.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Hashed assets are immutable: the URL changes whenever the bytes change.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # HTML must revalidate so updated asset references are picked up promptly.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>
